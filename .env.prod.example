# Production env for docker-compose.prod.yml. Copy to `.env` (compose reads
# `.env` by default) and fill in. Rotate every default credential.

# ── EXTERNAL LLM proxy (litellm/ollama are NOT in this compose) ──
# Point at your external litellm; it in turn fronts ollama / OpenAI / vLLM.
LITELLM_BASE_URL=http://your-litellm-host:4000
LITELLM_API_KEY=sk-change-me
# Embedding dim MUST match the Milvus collection (default 1536).
LITELLM_EMBEDDING_DIM=1536

# ── API ──
API_KEYS=change-me-strong-key
API_PORT=8000

# ── Secrets / credentials (ROTATE) ──
NEO4J_PASSWORD=change-me
POSTGRES_PASSWORD=change-me
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me
GRAFANA_ADMIN_PASSWORD=change-me

# ── Neo4j memory (size to host; Leiden on a large KG is heap-hungry) ──
NEO4J_HEAP_MAX=4G
NEO4J_PAGECACHE=2G

# ── Temporal (512 = prod floor; IMMUTABLE after first init) ──
TEMPORAL_NUM_HISTORY_SHARDS=512

# ── Opt-in features (Tracks 2/5 + wiki) ──
CLASSIFIER_ENABLED=false
# Max concurrent LLM requests across the process (single global semaphore).
# Paired with INGEST_ADMISSION_MAX_INFLIGHT (K = max in-flight documents).
LLM_POOL_N=8
# Admission always on; K = max in-flight documents.
INGEST_ADMISSION_MAX_INFLIGHT=1
WIKI_ENABLED=false
# Consumed once feature/redis-llm-cache merges:
LLM_CACHE_ENABLED=false

# ── Worker topology ──
# Empty = one container runs all 7 pools. To split for scaling, run
# multiple `worker` services each with a subset, e.g. WORKER_GROUPS=llm.
WORKER_GROUPS=

# ── Host port overrides (avoid collisions with other stacks) ──
# MINIO_CONSOLE_PORT default 9101 here to avoid clashing with mcp-search 9001.
# MINIO_CONSOLE_PORT=9101
# PROMETHEUS_PORT=9092
# GRAFANA_PORT=3001
