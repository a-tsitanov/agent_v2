# Production env for docker-compose.prod.yml. Copy to `.env` (compose reads
# `.env` by default) and fill in. Rotate every default credential.

# ── EXTERNAL LLM proxy (litellm/ollama are NOT in this compose) ──
# Point at your external litellm; it in turn fronts ollama / OpenAI / vLLM.
LITELLM_BASE_URL=http://your-litellm-host:4000
LITELLM_API_KEY=sk-change-me
# Models the external proxy serves (must exist in its model_list).
LITELLM_MODEL_SMALL=gpt-4o-mini
LITELLM_MODEL_LARGE=gpt-4o-mini
LITELLM_EMBEDDING_MODEL=text-embedding-3-small
# Vector width — MUST match the embedding model's native dim (e.g.
# text-embedding-3-small=1536, nomic-embed-text=768) or Milvus inserts fail.
MILVUS_DIM=1536

# ── API ──
API_KEYS=change-me-strong-key
API_PORT=8000

# ── Secrets / credentials (ROTATE) ──
NEO4J_PASSWORD=change-me
POSTGRES_PASSWORD=change-me
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me
GRAFANA_ADMIN_PASSWORD=change-me

# ── Neo4j memory (size to host; Leiden on a large KG is heap-hungry) ──
NEO4J_HEAP_MAX=4G
NEO4J_PAGECACHE=2G

# ── Temporal (512 = prod floor; IMMUTABLE after first init) ──
TEMPORAL_NUM_HISTORY_SHARDS=512

# ── Opt-in features (Tracks 2/5 + wiki) ──
CLASSIFIER_ENABLED=false
# Max concurrent LLM requests across the process (single global semaphore).
# Paired with INGEST_ADMISSION_MAX_INFLIGHT (K = max in-flight documents).
LLM_POOL_N=8
# Admission always on; K = max in-flight documents.
INGEST_ADMISSION_MAX_INFLIGHT=1
# Hierarchical communities + smart selection (default: single-level/lexical).
AGENT_COMMUNITY_MAX_LEVELS=1
AGENT_COMMUNITY_DYNAMIC_SELECTION=lexical
# Native-vector ER (run scripts/backfill_er_vector first on an existing graph).
AGENT_ER_USE_NATIVE_VECTOR_KNN=false
# Deployment label for ingest_metrics / Temporal search attributes.
ANALYTICS_ENV_NAME=prod

# ── Wiki editor + Wikibase (optional) ──
# To enable: `docker compose -f docker-compose.prod.yml --profile wikibase up -d`,
# bootstrap once (scripts/setup_wikibase.py), then set BOTH flags to true.
# Connection vars (WIKIBASE_BASE_URL, WIKI_MEDIAWIKI_API_URL, WIKI_DOCS_BASE_URL)
# default to the compose-internal services in docker-compose.prod.yml — do NOT
# set them here unless your wiki runs on a different host.
WIKI_ENABLED=false
WIKIBASE_ENABLED=false
# Bot creds must match the user created by setup_wikibase.py (ROTATE).
WIKIBASE_BOT_USER=KbBot
WIKIBASE_BOT_PASSWORD=change-me-bot
# Wikibase service admin/db creds (used by the `wikibase` profile services).
WIKIBASE_ADMIN_PASS=change-me-wb-admin
WIKIBASE_DB_PASSWORD=change-me-wb-db
WIKIBASE_SECRET_KEY=change-me-32-hex-secret

# Consumed once feature/redis-llm-cache merges:
LLM_CACHE_ENABLED=false

# ── Worker topology ──
# Empty = one container runs all 7 pools. To split for scaling, run
# multiple `worker` services each with a subset, e.g. WORKER_GROUPS=llm.
WORKER_GROUPS=

# ── Host port overrides (avoid collisions with other stacks) ──
# MINIO_CONSOLE_PORT default 9101 here to avoid clashing with mcp-search 9001.
# MINIO_CONSOLE_PORT=9101
# PROMETHEUS_PORT=9092
# GRAFANA_PORT=3001
