# kb-llamaindex — architecture diagram (D2)
# ---------------------------------------------------------------
# Render:
#   brew install d2
#   d2 docs/architecture.d2 docs/architecture.svg
#   d2 --theme=200 docs/architecture.d2 docs/architecture-dark.svg
#   d2 --layout=elk docs/architecture.d2 docs/architecture.svg   # for ELK layout
#
# Or paste into https://play.d2lang.com.
# ---------------------------------------------------------------

vars: {
  d2-config: {
    layout-engine: dagre
    pad: 80
    theme-id: 200
  }
}

# ════════════════════════════════════════════════════════════════
# 1. System topology — runtime services + data flow
# ════════════════════════════════════════════════════════════════

system: System topology {
  near: top-center
  style.font-size: 22

  client: Client {
    shape: person
    style.fill: "#e0e7ff"
  }

  # ─── API edge ───────────────────────────────────────────────
  api: FastAPI :8000 {
    style.fill: "#fff7ed"
    style.stroke: "#ffb454"
    style.stroke-width: 2

    ingest_route: POST /api/v1/ingest { shape: rectangle }
    search_route: POST /api/v1/search { shape: rectangle }
    agent_route: POST /api/v1/agent { shape: rectangle }
    selfrag_route: POST /api/v1/selfrag { shape: rectangle }
    health_route: GET /healthz { shape: rectangle }
    auth: X-API-Key middleware { shape: rectangle; style.fill: "#fde68a" }
  }

  # ─── Orchestration ──────────────────────────────────────────
  orch: Orchestration · Temporal {
    style.fill: "#f3e8ff"
    style.stroke: "#b794ff"
    style.stroke-width: 2

    server: Temporal Server :7233 {
      shape: cylinder
      style.fill: "#ede9fe"
    }

    worker: "Worker (Python)" {
      style.fill: "#ddd6fe"

      main_pool: "main pool · kb-ingest · concurrency=4"
      llm_pool: "llm pool · kb-ingest-llm · concurrency=1"
    }
  }

  # ─── 9 activities ───────────────────────────────────────────
  activities: Ingest activities (9 stages) {
    style.fill: "#fef2f8"
    style.stroke: "#f06a96"

    a1: 1 · fetch_source                                  { style.fill: "#fce7f3" }
    a2: "2 · parse_and_chunk\nrole=extraction"            { style.fill: "#fce7f3" }
    a3: 3 · index_vector                                  { style.fill: "#ffe4b5" }
    a4: 4 · inject_canonical                              { style.fill: "#fce7f3" }
    a5: "5 · extract_kg\nrole=extraction"                 { style.fill: "#ffe4b5" }
    a6: "6 · merge_and_resolve\nrole=judge (child)"       { style.fill: "#ffe4b5" }
    a7: "7 · build_property_graph\n(child)"               { style.fill: "#fce7f3" }
    a8: 8 · push_wikibase                                 { style.fill: "#fce7f3" }
    a9: 9 · finalize                                      { style.fill: "#dcfce7" }

    a1 -> a2 -> a3 -> a4 -> a5 -> a6 -> a7 -> a8 -> a9
  }

  # ─── Retrieval engines (search path) ────────────────────────
  retrieval: Retrieval (LlamaIndex) {
    style.fill: "#fef2f8"
    style.stroke: "#f06a96"

    hybrid: Hybrid retriever (vector + graph)
    react: ReAct agent
    selfrag: Self-RAG reflective synth
    rerank: BGE-reranker-v2-m3
  }

  # ─── Storage ────────────────────────────────────────────────
  storage: Storage layer {
    style.fill: "#ecfeff"
    style.stroke: "#6ee7f0"
    style.stroke-width: 2

    pg: PostgreSQL :5432 {
      shape: cylinder
      style.fill: "#cffafe"
      documents
      ingest_metrics
    }
    minio: "MinIO (S3) :9000" {
      shape: cylinder
      style.fill: "#cffafe"
      kb_uploads: kb-uploads bucket
      kb_staging: kb-staging bucket
    }
    milvus: Milvus :19530 {
      shape: cylinder
      style.fill: "#cffafe"
    }
    neo4j: Neo4j :7687 {
      shape: cylinder
      style.fill: "#cffafe"
    }
    wikibase: Wikibase :8181 {
      shape: cylinder
      style.fill: "#cffafe"
      wikibase_mysql: wikibase-mysql :3306
      wdqs: wdqs SPARQL :8989
    }
  }

  # ─── ML layer ───────────────────────────────────────────────
  ml: ML layer {
    style.fill: "#fdf2f8"
    style.stroke: "#f06a96"

    ollama: "Ollama :11434"
    qwen3: "qwen3:8b (LLM)"
    bge_m3: BGE-M3 (embeddings)
    reranker: BGE-reranker-v2-m3 (cross-encoder)
    litellm: LiteLLM gateway :4000
  }

  # ─── Observability ──────────────────────────────────────────
  obs: Observability {
    style.fill: "#f0fdf4"
    style.stroke: "#5dd39e"
    style.stroke-width: 2

    prom: Prometheus :9092 {
      shape: cylinder
      style.fill: "#bbf7d0"
    }
    grafana: Grafana :3001 {
      style.fill: "#bbf7d0"
      d1: 01 · Ingest Overview (live)
      d2: 02 · Version compare
      d3: 03 · Run drill-down
    }
    langfuse: LangFuse :3000 { style.fill: "#bbf7d0" }
    temporal_ui: Temporal UI :8080 { style.fill: "#bbf7d0" }
    structlog: structlog → stdout JSON
  }

  # ═══ Connections ═══════════════════════════════════════════
  client -> api.ingest_route: "HTTPS + X-Version-Tag" {
    style.stroke: "#0891b2"
    style.stroke-width: 2
  }
  client -> api.search_route: search
  client -> api.agent_route: agentic
  client -> api.selfrag_route: self-RAG

  api.ingest_route -> orch.server: "start_workflow + search_attrs" {
    style.stroke: "#7c3aed"
  }
  api.ingest_route -> storage.pg: "INSERT documents"
  api.ingest_route -> storage.minio: "put_object → kb-uploads"

  orch.server -> orch.worker: dispatch
  orch.worker -> activities: run

  api.search_route -> retrieval.hybrid
  api.agent_route -> retrieval.react
  api.selfrag_route -> retrieval.selfrag

  activities.a1 -> storage.minio: get_object
  activities.a2 -> ml.litellm: "semantic chunking (embed)"
  activities.a3 -> ml.litellm: BGE-M3 embed
  activities.a3 -> storage.milvus: insert chunks
  activities.a5 -> ml.litellm: LLM extract
  activities.a6 -> ml.litellm: ER LLM-judge
  activities.a7 -> storage.neo4j: write KG
  activities.a8 -> storage.wikibase: "create / update Items + claims"
  activities.a8 -> storage.neo4j: writeback wikibase_qid
  activities.a9 -> storage.pg: "UPDATE documents status"
  activities.a9 -> orch.server: "fetch_history() → extract timings"
  activities.a9 -> storage.pg: "INSERT ingest_metrics (×9 rows)"

  retrieval.hybrid -> storage.milvus: vector search
  retrieval.hybrid -> storage.neo4j: graph walk
  retrieval.hybrid -> retrieval.rerank: top-K → top-N
  retrieval.react -> ml.litellm: tool-calling LLM
  retrieval.selfrag -> ml.litellm: reflective LLM

  ml.litellm -> ml.ollama: "proxy (Ollama upstream)"
  ml.ollama -> ml.qwen3
  ml.ollama -> ml.bge_m3

  orch.worker -> obs.prom: "scrape /metrics (Temporal SDK exporter)" {
    style.stroke: "#16a34a"
    style.stroke-dash: 5
  }
  obs.prom -> obs.grafana: "datasource (live aggregates)" {
    style.stroke: "#16a34a"
    style.stroke-dash: 5
  }
  storage.pg -> obs.grafana: "datasource ingest_metrics (frozen)" {
    style.stroke: "#16a34a"
    style.stroke-dash: 5
  }
  activities -> obs.langfuse: LLM-call traces {
    style.stroke: "#16a34a"
    style.stroke-dash: 5
  }
  orch.server -> obs.temporal_ui: timeline / replay {
    style.stroke: "#16a34a"
    style.stroke-dash: 5
  }
  api -> obs.structlog: app-logs
  orch.worker -> obs.structlog
}


# ════════════════════════════════════════════════════════════════
# 2. Code map — Python packages under src/
# ════════════════════════════════════════════════════════════════

code: Codebase map (src/) {
  near: bottom-center
  style.font-size: 22

  # ─── API layer ──────────────────────────────────────────────
  api_pkg: src/api {
    style.fill: "#fff7ed"
    style.stroke: "#ffb454"

    main: main.py (FastAPI app)
    auth: auth.py (API-key)
    r_ingest: routes/ingest.py
    r_search: routes/search.py
    r_agent: routes/agent.py
    r_selfrag: routes/selfrag.py
    r_health: routes/health.py
  }

  # ─── Workflow ───────────────────────────────────────────────
  workflow_pkg: src/workflow {
    style.fill: "#f3e8ff"
    style.stroke: "#b794ff"

    worker: worker.py
    client: client.py
    doc_ingest: document_ingest.py (DocumentIngestWorkflow)
    contracts: contracts.py (Pydantic models)
    staging: staging.py (S3 pickle blobs)

    activities_pkg: activities/ {
      fetch_source
      parse_and_chunk
      index_vector
      inject_canonical
      extract_kg
      merge_and_resolve
      build_property_graph
      push_wikibase
      finalize
    }
  }

  # ─── Storage ────────────────────────────────────────────────
  storage_pkg: src/storage {
    style.fill: "#ecfeff"
    style.stroke: "#6ee7f0"

    postgres: postgres.py (documents)
    ingest_metrics_mod: "ingest_metrics.py ★"
    minio: minio.py
    chunk_repository: chunk_repository.py (Milvus)
    wikibase_mod: wikibase.py
  }

  # ─── Graph / KG ─────────────────────────────────────────────
  graph_pkg: src/graph {
    style.fill: "#ecfeff"
    style.stroke: "#6ee7f0"

    store: store.py (Neo4j)
    schema: schema.py
    index: index.py (PropertyGraphIndex)
    retriever: retriever.py
    lightrag_extract: lightrag_extract.py
    lightrag_parse: lightrag_parse.py
    lightrag_prompts: lightrag_prompts.py
    er: entity_resolution.py
    merge: merge.py
    phone: phone_consolidation.py
  }

  # ─── Ingestion helpers ──────────────────────────────────────
  ingestion_pkg: src/ingestion {
    style.fill: "#fdf2f8"
    style.stroke: "#f06a96"

    pipeline: pipeline.py (IngestionPipeline)
    run: run.py (CLI)
    embeddings: embeddings.py (BGE-M3)
    identifiers: identifiers.py (24 types)
    ident_xform: identifier_transform.py
    translate: translate_transform.py
  }

  # ─── Retrieval engines ──────────────────────────────────────
  retrieval_pkg: src/retrieval {
    style.fill: "#fdf2f8"
    style.stroke: "#f06a96"

    hybrid: hybrid.py
    vector_index: vector_index.py
    reranker: reranker.py
    query_engine: query_engine.py
    llm: llm.py
    judge: judge.py (legacy)
    agent: agent.py (legacy R10)
    react_agent: react_agent.py
    reflective_synth: reflective_synth.py
    common: _common.py
  }

  # ─── Cross-cutting ──────────────────────────────────────────
  cross_pkg: cross-cutting {
    style.fill: "#f0fdf4"
    style.stroke: "#5dd39e"

    config: config.py (11 Settings)
    di: di/providers.py
    logging: utils/logging.py (structlog)
    trace: observability/trace.py (LangFuse)
    metrics_extractor: "observability/ingest_metrics_extractor.py ★"
    models: models/search.py
  }

  scripts_pkg: scripts/ {
    style.fill: "#f0fdf4"
    style.stroke: "#5dd39e"

    setup_db: setup_db.py
    setup_wikibase: setup_wikibase.py
    wipe_db: wipe_db.py
    smoke_wb: smoke_wikibase_push.py
    check_ingestion: check_ingestion.py
    cleanup_staging: cleanup_staging.py
  }

  # ─── code dependencies (top-down) ──────────────────────────
  api_pkg.r_ingest -> workflow_pkg.client: get_temporal_client()
  api_pkg.r_ingest -> workflow_pkg.contracts: IngestParams
  api_pkg.r_ingest -> storage_pkg.postgres: insert_pending
  api_pkg.r_ingest -> storage_pkg.minio: put_object

  api_pkg.r_search -> retrieval_pkg.hybrid
  api_pkg.r_search -> retrieval_pkg.reranker
  api_pkg.r_agent -> retrieval_pkg.react_agent
  api_pkg.r_selfrag -> retrieval_pkg.reflective_synth

  workflow_pkg.worker -> workflow_pkg.activities_pkg
  workflow_pkg.doc_ingest -> workflow_pkg.activities_pkg
  workflow_pkg.activities_pkg -> storage_pkg
  workflow_pkg.activities_pkg -> graph_pkg
  workflow_pkg.activities_pkg -> ingestion_pkg
  workflow_pkg.activities_pkg.finalize -> cross_pkg.metrics_extractor
  workflow_pkg.activities_pkg.finalize -> storage_pkg.ingest_metrics_mod

  graph_pkg.er -> graph_pkg.merge
  graph_pkg.index -> graph_pkg.store
  graph_pkg.lightrag_extract -> graph_pkg.lightrag_parse
  graph_pkg.lightrag_extract -> graph_pkg.lightrag_prompts

  retrieval_pkg.hybrid -> graph_pkg.retriever
  retrieval_pkg.hybrid -> retrieval_pkg.vector_index
  retrieval_pkg.react_agent -> retrieval_pkg.llm
  retrieval_pkg.reflective_synth -> retrieval_pkg.llm

  scripts_pkg.setup_db -> storage_pkg.postgres
  scripts_pkg.setup_db -> storage_pkg.chunk_repository
  scripts_pkg.setup_wikibase -> storage_pkg.wikibase_mod

  api_pkg -> cross_pkg.config
  workflow_pkg -> cross_pkg.config
  storage_pkg -> cross_pkg.config
  graph_pkg -> cross_pkg.config
  ingestion_pkg -> cross_pkg.config
  retrieval_pkg -> cross_pkg.config
}

# ════════════════════════════════════════════════════════════════
# Legend
# ════════════════════════════════════════════════════════════════
legend: Legend {
  near: top-right
  shape: rectangle
  style.fill: "#fafafa"

  api_color: API edge { style.fill: "#fff7ed"; style.stroke: "#ffb454" }
  orch_color: Workflow · Temporal { style.fill: "#f3e8ff"; style.stroke: "#b794ff" }
  store_color: Storage { style.fill: "#ecfeff"; style.stroke: "#6ee7f0" }
  ml_color: ML / Retrieval { style.fill: "#fdf2f8"; style.stroke: "#f06a96" }
  obs_color: Observability { style.fill: "#f0fdf4"; style.stroke: "#5dd39e" }
  new_mark: "★ added in current sprint (analytics)"
}
