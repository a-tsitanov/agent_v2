      "command": "docker compose down -v",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "docker compose: ps",
      "type": "shell",
      "command": "docker compose ps",
      "problemMatcher": []
    },
    {
