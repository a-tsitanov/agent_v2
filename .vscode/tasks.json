{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "docker compose: up",
      "type": "shell",
      "command": "docker compose up -d",
      "problemMatcher": [],
      "group": "build",
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "docker compose: down",
      "type": "shell",
      "command": "docker compose down",
      "problemMatcher": []
    },
    {
      "label": "docker compose: down -v (wipe volumes)",
