# Generated from src/config.py by `python -m scripts.make_env --reference`.
# DO NOT EDIT BY HAND. Exhaustive catalog of every app env var.
# Secrets show an empty value (set them yourself).

# ── AgentSettings ──
# Стратегия выбора сообществ для global/drift: lexical (по умолчанию) | semantic (kNN по report_vec) | descent (спуск по иерархии).
AGENT_COMMUNITY_DYNAMIC_SELECTION=lexical
# Сколько уровней дендрограммы Leiden материализовать при build сообществ; 1 = одноуровневый, выше = иерархия (offline). Капа 1..10.
AGENT_COMMUNITY_MAX_LEVELS=1
# Учитывать историю диалога (мультитёрн): прежние реплики переписывают запрос в standalone-форму перед поиском. Пустая история = single-shot.
AGENT_CONVERSATION_HISTORY_ENABLED=true
# Pre-submit coverage-check: перед ответом LLM судит, покрывают ли собранные данные вопрос; при пробеле делается ещё один раунд поиска.
AGENT_COVERAGE_CHECK_ENABLED=true
# Entity Resolution: дополнительный шаг между merge_kg_extraction и PropertyGraphIndex, схлопывающий семантические дубликаты в один canonical-сущность.
AGENT_ER_ENABLED=true
# Сколько пар за один вызов LLM-судьи, когда ER маршрутизирует пограничных кандидатов. Капа 1..50.
AGENT_ER_JUDGE_BATCH_SIZE=10
# Для ER нативный Neo4j vector-index kNN вместо окна на 5000 сущностей (окно теряет кросс-док совпадения по мере роста графа). По умолчанию ON, fail-safe. Для СУЩЕСТВУЮЩИХ графов прогнать backfill_er_vector.py. false → вернуть legacy-окно.
AGENT_ER_USE_NATIVE_VECTOR_KNN=true
# Сколько соседей тянуть на новую сущность из ER vector-index, когда включён нативный kNN. Капа 1..100.
AGENT_ER_VECTOR_KNN_K=20
# Кэш вердиктов ER в Neo4j (:ERVerdict): повторяющиеся пары пропускают LLM. Опционально и fail-safe: при ошибке Neo4j откат на чистое LLM-судейство.
AGENT_ER_VERDICT_CACHE_ENABLED=true
# Сколько summary сообществ максимум входит в (параллельный) MAP-шаг global-поиска, чтобы корпус не разлетался безгранично. Капа 1..200.
AGENT_GLOBAL_MAX_COMMUNITIES=20
# path_depth для similarity graph_search: сколько triplet-хопов соседей тянуть вокруг каждой найденной сущности. По умолчанию 1, капа 1..3.
AGENT_GRAPH_SEARCH_PATH_DEPTH=1
# top_k кандидатов для graph-ретривера (VectorContextRetriever); поднят, чтобы именованная сущность не выпадала из выдачи на большом графе. Капа 1..100.
AGENT_GRAPH_SIMILARITY_TOP_K=20
# Сеять graph_walk сразу от топ-сущности graph_search И от топ find_entity_by_name (fulltext), когда они различаются — добавляет окрестность fulltext-совпадения.
AGENT_GRAPH_WALK_DUAL_SEED=true
# Multi-hop seeding: после graph_search авто-засеять bounded graph_walk от топ-сущности (без LLM tool-pick). Fail-open: ошибка walk проглатывается.
AGENT_GRAPH_WALK_ENABLED=true
# Фильтрация на retrieval: graph_walk выкидывает отрицаемые (polarity=negated) связи и рёбра с истёкшим valid_to. Opt-out, если мешает.
AGENT_GRAPH_WALK_FILTER_POLARITY_TEMPORAL=true
# Запрошенное число хопов для graph_walk (инструмент клампит к GRAPH_WALK_MAX_HOPS). По умолчанию 2, капа 1..3.
AGENT_GRAPH_WALK_HOPS=2
# Лимит символов истории диалога, передаваемой в контекстуализацию запроса. 0 = без истории. Капа >= 0.
AGENT_HISTORY_MAX_CHARS=4000
# Сколько последних реплик истории учитывать при контекстуализации запроса. 0 = single-shot. Капа 0..40.
AGENT_HISTORY_MAX_TURNS=6
# Макс. число доп. раундов coverage-check в plan-execute: на найденный пробел запускается ещё один SubQueryRetrievalWorkflow. Капа 0..3.
AGENT_MAX_COVERAGE_ROUNDS=1
# Макс. число подвопросов, которые может выдать планировщик — ограничивает параллельный fan-out SubQueryRetrievalWorkflow и стоимость планировщика. Капа 1..20.
AGENT_MAX_SUBQUERIES=5

# ── AnalyticsSettings ──
# Версия-тег по умолчанию, если на /ingest не пришёл заголовок X-Version-Tag; пишется в ingest_metrics / Temporal search attributes.
ANALYTICS_DEFAULT_VERSION_TAG=unspecified
# Имя окружения-деплоя для меток (Temporal search attributes и строки Postgres ingest_metrics).
ANALYTICS_ENV_NAME=dev-local

# ── ApiSettings ──
# Разрешённые CORS-origin через запятую; '*' = любой.
API_CORS_ORIGINS=*
# Окружение приложения (development|production); в production preflight жёстко требует реальные секреты.
API_ENV=development
# Ключи API через запятую (клиенты шлют в заголовке X-API-Key). В проде задать реальные, не плейсхолдеры. Секрет.
API_KEYS=   # secret
# Логировать в JSON (true) или в человекочитаемом виде (false).
API_LOG_JSON=false
# Уровень логирования FastAPI (info|debug|warning|...).
API_LOG_LEVEL=info
# Каталог для загруженных файлов на стороне API.
API_UPLOAD_DIR=/app/data/uploads

# ── ClassifierSettings ──
# Включить классификатор входных документов (отсев мусора до пайплайна). По умолчанию off; fail-soft: ошибка → INGEST.
CLASSIFIER_ENABLED=false
# Включить LLM-слой классификатора поверх детерминированных правил (оценка по ограниченному preview).
CLASSIFIER_LLM_ENABLED=true
# Максимальный размер документа (МБ); крупнее — отсев детерминированным правилом.
CLASSIFIER_MAX_SIZE_MB=25.0
# Минимальный размер документа (байт); мельче — отсев (пустышка/мусор).
CLASSIFIER_MIN_SIZE_BYTES=1
# Сколько символов превью документа подаётся LLM-слою классификатора.
CLASSIFIER_PREVIEW_CHARS=4000
# JSON-список расширений, отсекаемых детерминированным правилом (exe, zip, png, mp4 и т.п.).
CLASSIFIER_SKIP_EXTENSIONS=["exe", "dll", "bin", "zip", "tar", "gz", "7z", "png", "jpg", "jpeg", "gif", "bmp", "svg", "mp3", "mp4", "mov", "avi", "wav"]

# ── HFSettings ──
# Путь к локальному HF-кэшу для air-gapped деплоя; пусто = дефолт HF. Связано с download_models.py / configure_hf.
HF_CACHE_DIR=
# Включить offline-режим HuggingFace (читать только из локального кэша, без обращений к Hub).
HF_OFFLINE=false
# Имя BGE cross-encoder reranker-модели (по умолчанию BAAI/bge-reranker-v2-m3) для unified graph+vector rerank.
HF_RERANK_MODEL=BAAI/bge-reranker-v2-m3

# ── IngestAdmissionSettings ──
# K в модели K+N: максимум документов в работе одновременно (FIFO-допуск через singleton IngestSchedulerWorkflow). Капа >= 1.
INGEST_ADMISSION_MAX_INFLIGHT=1

# ── IngestionSettings ──
# Перцентиль расстояния для границ в semantic chunking (выше = реже резать). Действует при INGESTION_SEMANTIC_CHUNKING=true.
INGESTION_BREAKPOINT_PERCENTILE=95
# Каталог кэша ingest-пайплайна.
INGESTION_CACHE_DIR=/app/data/ingestion_cache
# Перекрытие соседних чанков (в токенах) для SentenceSplitter.
INGESTION_CHUNK_OVERLAP=50
# Размер чанка (в токенах) для SentenceSplitter.
INGESTION_CHUNK_SIZE=512
# GLiNER span-NER модель для opt-in режимов gliner / gliner+llm; требует extra 'gliner'. Дефолтный путь (lightrag) её не трогает.
INGESTION_GLINER_MODEL=urchade/gliner_multi-v2.1
# Вместо SentenceSplitter использовать SemanticSplitter (резать по сдвигам темы). Доп. embedding-вызовы за лучшую точность retrieval. По умолчанию off.
INGESTION_SEMANTIC_CHUNKING=false
# Per-chunk LLM-перевод в metadata['translated_text'] (исходный текст не меняется); KG-экстрактор читает перевод → сущности по-русски для кросс-язычного дедупа.
INGESTION_TRANSLATE_TO_RUSSIAN=true
# Сколько LLM-вызовов перевода идут параллельно.
INGESTION_TRANSLATION_CONCURRENCY=4
# Мягкий лимит символов для перевода документа одним вызовом; выше — режется на абзац-выровненные окна. Дефолт 30k под Ollama qwen3 32k-контекст.
INGESTION_TRANSLATION_DOC_THRESHOLD_CHARS=30000
# Как делить работу перевода: per_document | per_chunk | auto (по умолчанию; per_document под порогом, иначе per_chunk).
INGESTION_TRANSLATION_STRATEGY=auto

# ── LLMPoolSettings ──
# N в модели K+N: максимум одновременных LLM-вызовов на процесс (единый глобальный семафор на все роли). Капа >= 1.
LLM_POOL_N=8

# ── LiteLLMSettings ──
# Ключ к LiteLLM-прокси (OpenAI-совместимый). Секрет.
LITELLM_API_KEY=   # secret
# Base URL LiteLLM-прокси (или любого OpenAI-совместимого эндпоинта).
LITELLM_BASE_URL=http://localhost:4000
# Имя embedding-модели; её native-dim ДОЛЖНА совпадать с MILVUS_DIM (text-embedding-3-small → 1536).
LITELLM_EMBEDDING_MODEL=text-embedding-3-small
# JSON доп.полей тела КАЖДОГО chat-запроса (через OpenAI extra_body), напр. {"think": false} чтобы выключить chain-of-thought Qwen3. Пусто ⇒ запрос не меняется.
LITELLM_EXTRA_BODY={}
# JSON per-role override'ов extra_body; shallow-мёрж поверх LITELLM_EXTRA_BODY, ключи роли побеждают. Напр. {"synthesis": {"think": true}} — оставить thinking только для финального ответа.
LITELLM_EXTRA_BODY_ROLES={}
# DEPRECATED-алиас no-role legacy-пути; пусто ⇒ откат на model_small. Удалить, когда все читатели перейдут на tier-поля.
LITELLM_LLM_MODEL=
# Сколько повторов на сетевую/временную ошибку LLM-вызова.
LITELLM_MAX_RETRIES=2
# Имя 'large'-модели: только финальный user-facing synthesis (дефолт gpt-4o-mini).
LITELLM_MODEL_LARGE=gpt-4o-mini
# Имя 'small'-модели: локальная высоконагруженная (extraction/judge/search/plan/...).
LITELLM_MODEL_SMALL=gpt-4o-mini
# JSON-override карты роль→tier; мёржится поверх дефолтов, можно эскалировать одну роль, напр. {"plan":"large"}.
LITELLM_ROLE_TIERS={"extraction": "small", "judge": "small", "search": "small", "route": "small", "plan": "small", "retrieve": "small", "synthesis": "large"}
# Таймаут LLM-вызова в секундах (дефолт 900 — под медленный локальный inference).
LITELLM_TIMEOUT_S=900.0

# ── MetricsSettings ──
# Адрес:порт, на котором воркер поднимает Prometheus-листенер; Prometheus скрейпит через host.docker.internal:<port>.
METRICS_BIND_ADDRESS=0.0.0.0:9090
# Включить worker-side Prometheus-экспортёр (Temporal Runtime + PrometheusConfig).
METRICS_ENABLED=true

# ── MilvusSettings ──
# Имя коллекции чанков в Milvus.
MILVUS_COLLECTION=kb_llamaindex
# Размерность вектора в Milvus; ДОЛЖНА совпадать с native-dim embedding-модели (1536 для text-embedding-3-small, 768 для nomic-embed-text).
MILVUS_DIM=1536
# HNSW build-time search width: выше → лучше recall, медленнее build. Действует при создании коллекции с index_type=HNSW.
MILVUS_HNSW_EF_CONSTRUCTION=200
# HNSW query-time search width (ef): выше → лучше recall, медленнее запрос. Должно быть >= search top_k.
MILVUS_HNSW_EF_SEARCH=64
# Степень HNSW-графа (M): выше → лучше recall, больше памяти.
MILVUS_HNSW_M=16
# Хост Milvus (внутри compose — DNS-имя сервиса, напр. milvus).
MILVUS_HOST=localhost
# Тип ANN-индекса коллекции: HNSW (по умолчанию, approximate) или FLAT (точный перебор). Действует только при (пере)создании коллекции.
MILVUS_INDEX_TYPE=HNSW
# Порт Milvus (по умолчанию 19530).
MILVUS_PORT=19530
# Таймаут обращений к Milvus в секундах.
MILVUS_TIMEOUT_S=10.0

# ── MinioSettings ──
# Access key MinIO/S3. Секрет; в проде задать реальный.
MINIO_ACCESS_KEY=   # secret
# Бакет для пользовательских загрузок (kb-uploads).
MINIO_BUCKET=kb-uploads
# Куда воркер стейджит скачанные файлы перед обработкой; чистится активити cleanup_local после run.
MINIO_DOWNLOAD_DIR=/tmp/kb-cache
# Endpoint MinIO/S3 (host:port).
MINIO_ENDPOINT=localhost:9000
# Регион S3 (для совместимых клиентов).
MINIO_REGION=us-east-1
# Secret key MinIO/S3. Секрет; в проде задать реальный.
MINIO_SECRET_KEY=   # secret
# Использовать TLS (https) при обращении к MinIO/S3.
MINIO_SECURE=false

# ── Neo4jSettings ──
# Имя базы Neo4j.
NEO4J_DATABASE=neo4j
# Пароль Neo4j. Секрет; в проде сменить дефолт 'changeme'.
NEO4J_PASSWORD=   # secret
# Bolt-URI Neo4j (напр. bolt://localhost:7687).
NEO4J_URI=bolt://localhost:7687
# Пользователь Neo4j.
NEO4J_USER=neo4j

# ── PostgresSettings ──
# Таймаут подключения к Postgres в секундах.
POSTGRES_CONNECT_TIMEOUT_S=10
# Имя базы Postgres.
POSTGRES_DB=kb_llamaindex
# Хост Postgres.
POSTGRES_HOST=localhost
# Пароль Postgres. Секрет; в проде сменить дефолт 'postgres'.
POSTGRES_PASSWORD=   # secret
# Порт Postgres (по умолчанию 5432).
POSTGRES_PORT=5432
# Пользователь Postgres.
POSTGRES_USER=postgres

# ── TemporalSettings ──
# Слотов активити на основной очереди kb-ingest.
TEMPORAL_ACTIVITY_CONCURRENCY=4
# Число GDS-потоков для прогона Leiden; держать умеренным, чтобы rebuild не голодил Neo4j. >= 1.
TEMPORAL_COMMUNITY_LEIDEN_CONCURRENCY=4
# Resolution Leiden: >1 → больше мелких сообществ, <1 → меньше крупных. Только детекция, не query-путь. > 0.
TEMPORAL_COMMUNITY_LEIDEN_GAMMA=1.0
# Сообщества мельче этого порога игнорируются (слишком мелкие для осмысленного summary — шум).
TEMPORAL_COMMUNITY_MIN_SIZE=3
# Bounded-параллелизм fan-out суммаризации сообществ внутри CommunityBuildWorkflow (независимо от worker-капа активити).
TEMPORAL_COMMUNITY_SUMMARY_PARALLELISM=4
# Слотов на выделенной очереди kb-graph-build (offline build сообществ). Намеренно низкий, чтобы не флудить LLM-прокси.
TEMPORAL_GRAPH_BUILD_ACTIVITY_CONCURRENCY=2
# Имя очереди для offline graph-community build (GDS Leiden + per-community summary); не трогает query hot-path.
TEMPORAL_GRAPH_BUILD_TASK_QUEUE=kb-graph-build
# Хост Temporal.
TEMPORAL_HOST=localhost
# Слотов на очереди kb-search-large; намеренно НИЗКИЙ — тяжёлая large-модель не должна обслуживать много параллельных сессий.
TEMPORAL_LARGE_ACTIVITY_CONCURRENCY=2
# Имя очереди для large-tier финального synthesis (synthesize_answer пинится сюда).
TEMPORAL_LARGE_TASK_QUEUE=kb-search-large
# Слотов на очереди kb-ingest-llm; должно быть >= LLM_POOL_N, чтобы троттлил пул, а не Temporal.
TEMPORAL_LLM_ACTIVITY_CONCURRENCY=18
# Имя очереди для LLM-bound активити extract_kg (отдельно от основного ингеста).
TEMPORAL_LLM_TASK_QUEUE=kb-ingest-llm
# Слотов на очереди kb-ingest-merge; должно быть >= LLM_POOL_N (иначе Temporal троттлит раньше пула).
TEMPORAL_MERGE_ACTIVITY_CONCURRENCY=14
# Имя очереди merge-стадии (merge_and_resolve + build_property_graph) — отдельно, чтобы merge не голодал за burst-ом extract.
TEMPORAL_MERGE_TASK_QUEUE=kb-ingest-merge
# Namespace Temporal.
TEMPORAL_NAMESPACE=default
# Порт Temporal (по умолчанию 7233).
TEMPORAL_PORT=7233
# top-N bge cross-encoder для unified graph+vector rerank перед дорогим large-tier synthesis.
TEMPORAL_RERANK_TOP_N=5
# Слотов на очереди kb-search-small (plan-execute поток: planner + параллельный retrieval подвопросов). >= 1.
TEMPORAL_SEARCH_ACTIVITY_CONCURRENCY=4
# Имя очереди search-активити small-tier (plan/retrieve/coverage_check/rerank); раньше kb-search-llm.
TEMPORAL_SEARCH_TASK_QUEUE=kb-search-small
# Имя staging-бакета Temporal.
TEMPORAL_STAGING_BUCKET=kb-staging
# Имя основной очереди ингеста (kb-ingest).
TEMPORAL_TASK_QUEUE=kb-ingest

# ── WikiSettings ──
# Слотов активити на очереди kb-wiki (редактор статей). >= 1.
WIKI_ACTIVITY_CONCURRENCY=4
# Сколько источников-цитат подтягивать в статью. >= 1.
WIKI_CITATIONS_TOP_K=8
# Base URL ссылок на документы-источники в секции 'Источники' (GET {docs_base_url}/documents/{doc_id}).
WIKI_DOCS_BASE_URL=http://localhost:8000/api/v1
# Включить редактор wiki-статей (Project A): генерирует per-entity MediaWiki-страницы из графа Neo4j. По умолчанию off.
WIKI_ENABLED=false
# Капа 1-hop связей в промпте статьи (ранжируются по mention_count соседа). Ограничивает размер промпта для hub-сущностей. >= 1.
WIKI_MAX_RELATIONS=30
# URL MediaWiki Action API; пусто → выводится из wikibase.base_url + '/w/api.php'.
WIKI_MEDIAWIKI_API_URL=
# Site global id MediaWiki для sitelinks; должен совпадать с реальным id вики (дефолт под dev-compose).
WIKI_SITE_GLOBAL_ID=kbwiki
# Размер пачки сущностей за один проход sweep. >= 1.
WIKI_SWEEP_BATCH=50
# Интервал sweep-прохода редактора статей (минуты). >= 1.
WIKI_SWEEP_INTERVAL_MINUTES=15
# Имя очереди Temporal для редактора wiki-статей (kb-wiki).
WIKI_TASK_QUEUE=kb-wiki

# ── WikibaseSettings ──
# Base URL self-hosted Wikibase.
WIKIBASE_BASE_URL=http://localhost:8181
# Пароль бота Wikibase (>= 8 символов); им логинится push_wikibase. Создание бота — scripts/setup_wikibase.py. Секрет.
WIKIBASE_BOT_PASSWORD=   # secret
# Имя бот-пользователя Wikibase (по умолчанию KbBot).
WIKIBASE_BOT_USER=KbBot
# Включить push в Wikibase после успешного graph build (canonical-сущности + связи + identifier-statements). По умолчанию off.
WIKIBASE_ENABLED=false
# Язык лейблов/описаний в Wikibase (по умолчанию ru).
WIKIBASE_LANGUAGE=ru
# Таймаут обращений к Wikibase API в секундах.
WIKIBASE_TIMEOUT_S=30.0
