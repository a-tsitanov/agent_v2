# kb-llamaindex — example environment variables
#
# Copy to `.env` and adjust for local dev. All settings are loaded via
# pydantic-settings with the prefixes shown below.

# ── API ──────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_ENV=development
API_LOG_LEVEL=info
API_LOG_JSON=false
API_KEYS=dev-local-key
API_CORS_ORIGINS=*
API_UPLOAD_DIR=/app/data/uploads

# ── Milvus ───────────────────────────────────────────────────────────
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=kb_llamaindex
MILVUS_TIMEOUT_S=10.0
MILVUS_DIM=768

# ── Neo4j ────────────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme
NEO4J_DATABASE=neo4j
NEO4J_TIMEOUT_S=30.0

# ── Postgres ─────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=kb_llamaindex
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_CONNECT_TIMEOUT_S=10

# ── LiteLLM (OpenAI-compatible LLM proxy) ───────────────────────────
LITELLM_BASE_URL=http://localhost:4000
LITELLM_API_KEY=sk-litellm-stub
# Default model: qwen3:8b — strong tool calling and structured
# output via Ollama Hermes-style integration.  Escalation path
# if quality is insufficient: qwen3:14b → qwen3:32b (see docs/MODELS.md).
LITELLM_LLM_MODEL=qwen3:8b
LITELLM_EMBEDDING_MODEL=nomic-embed-text
LITELLM_EMBEDDING_DIM=768
LITELLM_TIMEOUT_S=900.0
LITELLM_MAX_RETRIES=2

# ── RabbitMQ ─────────────────────────────────────────────────────────
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_TIMEOUT_S=10.0

# ── Ingestion ────────────────────────────────────────────────────────
INGESTION_CHUNK_SIZE=512
INGESTION_CHUNK_OVERLAP=50
INGESTION_BREAKPOINT_PERCENTILE=95
INGESTION_BATCH_SIZE=10
INGESTION_CACHE_DIR=/app/data/ingestion_cache

# ── Agent ────────────────────────────────────────────────────────────
# Legacy judge-based loop (used by /api/v1/agent-legacy if enabled).
AGENT_MAX_ROUNDS=3
AGENT_TOP_K=10
# ReAct loop cap (used by /api/v1/agent and /api/v1/selfrag).
AGENT_MAX_ITERATIONS=8
# Reflective synthesis cap (used by /api/v1/selfrag).
AGENT_MAX_REFINEMENTS=3
