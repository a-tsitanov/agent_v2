# kb-llamaindex — example environment variables
#
# Copy to `.env` and adjust for local dev. All settings are loaded via
# pydantic-settings with the prefixes shown below.

# ── OpenAI upstream (used by LiteLLM proxy) ─────────────────────────
# Required when docker/litellm_config.yaml points at openai/*.  Empty
# is fine if you're running the proxy against a local model (Ollama,
# vLLM, etc.) instead — see git history for the Ollama config.
OPENAI_API_KEY=

# ── API ──────────────────────────────────────────────────────────────
API_PORT=8000
API_ENV=development
API_LOG_LEVEL=info
API_LOG_JSON=false
API_KEYS=dev-local-key
API_CORS_ORIGINS=*
API_UPLOAD_DIR=/app/data/uploads

# ── Milvus ───────────────────────────────────────────────────────────
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=kb_llamaindex
MILVUS_TIMEOUT_S=10.0
MILVUS_DIM=1536

# ── Neo4j ────────────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme
NEO4J_DATABASE=neo4j

# ── Postgres ─────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=kb_llamaindex
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_CONNECT_TIMEOUT_S=10

# ── LiteLLM (OpenAI-compatible LLM proxy) ───────────────────────────
LITELLM_BASE_URL=http://localhost:4000
LITELLM_API_KEY=sk-litellm-stub
# ── Two physical model tiers (you manage exactly TWO names) ─────────
# Every logical role resolves to one of these via a declarative
# role→tier map.  Default: everything runs on `small` (local, high
# volume) EXCEPT the final answer synthesis which runs on `large`.
#   small → local / cheap / fast (extraction, judge, search, plan, …)
#   large → final user-facing synthesis only
# See docs/MODELS.md for the role→tier table and escalation path.
LITELLM_MODEL_SMALL=gemma4:e4b
LITELLM_MODEL_LARGE=gpt-4o-mini
# Escalate a single role to the large tier without re-declaring the
# rest (JSON, merged onto the defaults).  Example:
#   LITELLM_ROLE_TIERS={"plan":"large"}
# LITELLM_ROLE_TIERS=
LITELLM_EMBEDDING_MODEL=text-embedding-3-small
LITELLM_TIMEOUT_S=120.0
LITELLM_MAX_RETRIES=2

# ── Offline HuggingFace models (air-gapped deploys) ──────────────────
# Two models come from the HuggingFace Hub (everything else goes through
# the LiteLLM proxy): the GLiNER span-NER model
# (INGESTION_GLINER_MODEL) and the BGE cross-encoder reranker below.
# Pre-download them ONLINE into a cache with
#   python -m scripts.download_models --cache-dir /data/hf
# then set HF_OFFLINE=true + HF_CACHE_DIR=/data/hf on the air-gapped
# host.  See docs/MODELS.md → "Offline / air-gapped models".
# NOTE: these are the project's OWN vars (read with explicit aliases);
# they are distinct from HuggingFace's own HF_HOME / HF_HUB_OFFLINE,
# which the app derives from these and sets itself.
HF_OFFLINE=false
HF_CACHE_DIR=
HF_RERANK_MODEL=BAAI/bge-reranker-v2-m3

# ── MinIO (S3-compatible upload storage) ─────────────────────────────
# `/api/v1/ingest` puts each uploaded file in MINIO_BUCKET; documents.path
# stores the resulting s3://… URI.  Worker downloads to MINIO_DOWNLOAD_DIR
# before processing and removes the local copy afterwards.  Default
# config reuses the MinIO instance that backs Milvus (compose service
# `minio`) — only the bucket is new.  In production swap to an external
# S3 endpoint and rotate the credentials.
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=kb-uploads
MINIO_SECURE=false
MINIO_DOWNLOAD_DIR=/tmp/kb-cache

# ── Ingestion ────────────────────────────────────────────────────────
INGESTION_CHUNK_SIZE=512
INGESTION_CHUNK_OVERLAP=50
INGESTION_BREAKPOINT_PERCENTILE=95
INGESTION_CACHE_DIR=/app/data/ingestion_cache
# Per-chunk LLM translation: fills metadata["translated_text"] so
# the KG extractor produces Russian entity names + descriptions
# (cross-language graph dedup).  Original chunk text is preserved
# in Milvus / Neo4j for citation fidelity.  Disable to skip the
# +N LLM-calls per document; graph stays in source language.
INGESTION_TRANSLATE_TO_RUSSIAN=true
INGESTION_TRANSLATION_CONCURRENCY=4
# Translation strategy:
#   * `auto` (default) — single LLM call for docs below
#     INGESTION_TRANSLATION_DOC_THRESHOLD_CHARS, per-chunk for larger.
#   * `per_document` — always pre-translate at document level.
#   * `per_chunk` — translate each chunk independently (legacy).
INGESTION_TRANSLATION_STRATEGY=auto
# Hard cap (chars) for the single-call per-document path.  Default
# 30_000 ≈ 7.5k tokens, safe for Ollama qwen3's 32k native context
# (leaves room for output + prompt overhead).  For gpt-4o-mini /
# gpt-4o (128k ctx) bump to 200_000-400_000 for fewer windows and
# better cross-sentence context per call.
INGESTION_TRANSLATION_DOC_THRESHOLD_CHARS=30000
# Semantic chunking: SemanticSplitterNodeParser instead of fixed-
# token SentenceSplitter.  Embeds each sentence to detect topic
# boundaries; chunks size becomes variable but aligns with content
# structure.  Costs ~1 extra embedding call per sentence during
# ingest (text-embedding-3-small is cheap, but it adds latency).
# Off by default — turn on after the corpus is stable and
# retrieval precision needs tuning.
INGESTION_SEMANTIC_CHUNKING=false

# ── Input document classifier (opt-in) ──────────────────────────────
# Skips junk documents before they cost any parse/embed/extract work.
# Runs as the `classify_document` activity between fetch_source and
# parse_and_chunk.  Two layers: deterministic rules (extension / size /
# empty) then an optional LLM gate over a bounded preview.  On skip the
# document gets the terminal status `skipped` + a reason (no parse/index/
# graph).  Fail-soft: any classifier error defaults to INGEST (a false-
# skip loses a good document — the costly error).  `force=true` on
# POST /ingest bypasses the deterministic rules.  Off by default.
CLASSIFIER_ENABLED=false
CLASSIFIER_MAX_SIZE_MB=25.0
CLASSIFIER_MIN_SIZE_BYTES=1
# JSON list of blocked extensions (no dot, case-insensitive). Default
# blocks binaries/archives/media. Override example:
#   CLASSIFIER_SKIP_EXTENSIONS=["exe","zip","png","mp4"]
# CLASSIFIER_SKIP_EXTENSIONS=
# Chars of the file fed to the LLM gate.
CLASSIFIER_PREVIEW_CHARS=4000
# Run the LLM gate after the rules pass (false = rules-only).
CLASSIFIER_LLM_ENABLED=true

# ── Document admission control (always on) ───────────────────────────
# /ingest hands documents to a singleton IngestSchedulerWorkflow that
# runs at most MAX_INFLIGHT documents at once, FIFO — so a document's
# merge tail isn't starved behind newer documents' extract bursts.
# K = MAX_INFLIGHT = max in-flight documents. Paired with LLM_POOL_N
# (N = max concurrent LLM requests, single global semaphore).
# MAX_INFLIGHT=1 = strict finish-before-next; raise to overlap I/O
# stages of one document with the GPU stage of another.
INGEST_ADMISSION_MAX_INFLIGHT=1

# ── Agent ────────────────────────────────────────────────────────────
# Plan-execute fan-out: max sub-questions the planner may emit.
AGENT_MAX_SUBQUERIES=5
# Entity Resolution — collapses semantic duplicates ("BCC" ≡
# "Базальноклеточный рак", "Иванов И.И." ≡ "Иван Иванов", ...) into
# one canonical entity post-merge.  Adds ~50-100 LLM judge calls per
# 1 MB ingest (~$0.07-0.12 on gpt-4o-mini).  Off → graph keeps
# orthographic duplicates from prior pipeline.
AGENT_ER_ENABLED=true
AGENT_ER_JUDGE_BATCH_SIZE=10
# R10: mount /api/v1/legacy/agent route as comparative baseline
# for answer-quality eval.  Production traffic should use /agent or
# /selfrag, not the legacy judge path.
AGENT_ENABLE_LEGACY_AGENT=false

# Temporal
TEMPORAL_HOST=localhost
TEMPORAL_PORT=7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=kb-ingest
TEMPORAL_ACTIVITY_CONCURRENCY=4
TEMPORAL_STAGING_BUCKET=kb-staging
# GPU-bound activities (extract_kg + merge_and_resolve) run on this
# separate task queue so we can cap LLM concurrency independently of
# the fast IO activities.  Default 1 = one LLM call at a time across
# all concurrent workflows (sane for a single local GPU).
TEMPORAL_LLM_TASK_QUEUE=kb-ingest-llm
# Pool owns LLM concurrency now; keep this >= LLM_POOL extraction ceiling.
TEMPORAL_LLM_ACTIVITY_CONCURRENCY=18
# Merge stage (GraphBuildWorkflow: merge_and_resolve +
# build_property_graph) runs on its OWN queue so it interleaves with
# extract instead of queueing behind a burst of extract_kg; LLMPool
# owns real concurrency — these caps just need to be >= lane ceilings.
TEMPORAL_MERGE_TASK_QUEUE=kb-ingest-merge
# Keep >= LLM_POOL judge ceiling.
TEMPORAL_MERGE_ACTIVITY_CONCURRENCY=14

# Search-side workflow queue (SearchWorkflow + 3 activities:
# agent_reasoning_step / tool_execution / synthesize_answer).
# Independent from the ingest LLM queue so search latency doesn't
# pile up behind heavy ingest batches.  Default 4 = up to four
# concurrent search sessions; tune up if LLM proxy quota permits.
TEMPORAL_SEARCH_TASK_QUEUE=kb-search-small
TEMPORAL_SEARCH_ACTIVITY_CONCURRENCY=4

# Large-tier synthesis queue (Plan #2 R5): final synthesis runs the
# large model here on a separate, low-concurrency worker pool so
# expensive calls are bounded independently of small-tier search work.
TEMPORAL_LARGE_TASK_QUEUE=kb-search-large
TEMPORAL_LARGE_ACTIVITY_CONCURRENCY=2

# Offline community-build queue (Plan #2 R6): GDS Leiden detection +
# batch community summaries (CommunityBuildWorkflow). Fully decoupled
# from the query hot path; triggered by /admin/communities/rebuild.
TEMPORAL_GRAPH_BUILD_TASK_QUEUE=kb-graph-build
TEMPORAL_GRAPH_BUILD_ACTIVITY_CONCURRENCY=2
# GDS Leiden detection knobs (community build only — never the query path).
# GAMMA = resolution: >1 → more, smaller communities; <1 → fewer, larger.
# CONCURRENCY = GDS worker threads for the Leiden run.
TEMPORAL_COMMUNITY_LEIDEN_GAMMA=1.0
TEMPORAL_COMMUNITY_LEIDEN_CONCURRENCY=4

# GraphRAG global search tuners (Plan #2 R7): cap on communities
# considered per global query.
AGENT_GLOBAL_MAX_COMMUNITIES=20


# ── LLM concurrency pool (per-process; owns LLM concurrency) ──
# K + N model: LLM_POOL_N = max concurrent LLM requests (single global
# semaphore). Paired with INGEST_ADMISSION_MAX_INFLIGHT (K = max in-flight
# documents). Size N to your proxy/GPU knee.
LLM_POOL_N=8

# Wikibase
WIKIBASE_ENABLED=false
WIKIBASE_BASE_URL=http://localhost:8181
WIKIBASE_HOST_PORT=8181
WIKIBASE_WDQS_PORT=8989
WIKIBASE_BOT_USER=KbBot
# MediaWiki rejects passwords <8 chars at user-creation time;
# scripts/setup_wikibase.py provisions this account via createAndPromote.
WIKIBASE_BOT_PASSWORD=KbBot-Secret-2026
WIKIBASE_ADMIN_USER=WikibaseAdmin
# MediaWiki requires admin password >=10 chars, not in common-password list.
WIKIBASE_ADMIN_PASS=ChangeMe-Wb-Admin-2026
WIKIBASE_DB_PASSWORD=sqlpass
WIKIBASE_DB_ROOT_PASSWORD=rootpass
# Encryption key — generate 32 hex chars per instance.
WIKIBASE_SECRET_KEY=deadbeefdeadbeefdeadbeefdeadbeef
WIKIBASE_LANGUAGE=ru
WIKIBASE_TIMEOUT_S=30

# ── Continuous wiki editor (Project A; opt-in) ──────────────────────
# Generates per-entity MediaWiki article pages from the Neo4j graph.
WIKI_ENABLED=false
WIKI_TASK_QUEUE=kb-wiki
WIKI_ACTIVITY_CONCURRENCY=4
WIKI_SWEEP_BATCH=50
WIKI_SWEEP_INTERVAL_MINUTES=15
WIKI_CITATIONS_TOP_K=5
# Empty -> derived from WIKIBASE_BASE_URL + /w/api.php
WIKI_MEDIAWIKI_API_URL=
# MediaWiki site global id for Item↔page sitelinks (must match the wiki).
WIKI_SITE_GLOBAL_ID=kbwiki

# ── Metrics + analytics (Stage 1: docker-compose; Stage 2: worker exporter) ──
# Prometheus + Grafana run as docker-compose services.  The Python
# worker exposes Prometheus metrics directly on host port 9090 so
# Prometheus (which runs in a container) reaches it via host.docker.internal.
PROMETHEUS_PORT=9092
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Worker-side Prometheus exporter (Stage 2 toggles).  When METRICS_ENABLED=true
# the worker calls Runtime(TelemetryConfig(PrometheusConfig(...))) at startup.
METRICS_ENABLED=true
METRICS_BIND_ADDRESS=0.0.0.0:9090

# Default version_tag attached to ingest workflows when caller omits the
# X-Version-Tag header.  Set per-batch when measuring after model swaps.
ANALYTICS_VERSION_TAG=unspecified
# Human-friendly environment label propagated to ingest_metrics rows + Temporal
# search attributes.  E.g. "dev-laptop", "staging", "prod-aws-eu-west-1".
ANALYTICS_ENV_NAME=dev-local
