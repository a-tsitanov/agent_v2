# kb-llamaindex — example environment variables
#
# Copy to `.env` and adjust for local dev. All settings are loaded via
# pydantic-settings with the prefixes shown below.

# ── OpenAI upstream (used by LiteLLM proxy) ─────────────────────────
# Required when docker/litellm_config.yaml points at openai/*.  Empty
# is fine if you're running the proxy against a local model (Ollama,
# vLLM, etc.) instead — see git history for the Ollama config.
OPENAI_API_KEY=

# ── API ──────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_ENV=development
API_LOG_LEVEL=info
API_LOG_JSON=false
API_KEYS=dev-local-key
API_CORS_ORIGINS=*
API_UPLOAD_DIR=/app/data/uploads

# ── Milvus ───────────────────────────────────────────────────────────
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=kb_llamaindex
MILVUS_TIMEOUT_S=10.0
MILVUS_DIM=1536

# ── Neo4j ────────────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme
NEO4J_DATABASE=neo4j
NEO4J_TIMEOUT_S=30.0

# ── Postgres ─────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=kb_llamaindex
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_CONNECT_TIMEOUT_S=10

# ── LiteLLM (OpenAI-compatible LLM proxy) ───────────────────────────
LITELLM_BASE_URL=http://localhost:4000
LITELLM_API_KEY=sk-litellm-stub
# Default models: OpenAI gpt-4o-mini + text-embedding-3-small.  Set
# OPENAI_API_KEY above; LiteLLM container reads it via env.  To swap
# back to a local stack (Ollama / vLLM) change docker/litellm_config.yaml
# and the model names + dim below — see docs/MODELS.md.
LITELLM_LLM_MODEL=gpt-4o-mini
LITELLM_EMBEDDING_MODEL=text-embedding-3-small
LITELLM_EMBEDDING_DIM=1536
LITELLM_TIMEOUT_S=120.0
LITELLM_MAX_RETRIES=2

# ── RabbitMQ ─────────────────────────────────────────────────────────
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_TIMEOUT_S=10.0

# ── Ingestion ────────────────────────────────────────────────────────
INGESTION_CHUNK_SIZE=512
INGESTION_CHUNK_OVERLAP=50
INGESTION_BREAKPOINT_PERCENTILE=95
INGESTION_BATCH_SIZE=10
INGESTION_CACHE_DIR=/app/data/ingestion_cache
# Per-chunk LLM translation: fills metadata["translated_text"] so
# the KG extractor produces Russian entity names + descriptions
# (cross-language graph dedup).  Original chunk text is preserved
# in Milvus / Neo4j for citation fidelity.  Disable to skip the
# +N LLM-calls per document; graph stays in source language.
INGESTION_TRANSLATE_TO_RUSSIAN=true
INGESTION_TRANSLATION_CONCURRENCY=4

# ── Agent ────────────────────────────────────────────────────────────
# Legacy judge-based loop (used by /api/v1/legacy/agent if enabled).
AGENT_MAX_ROUNDS=3
AGENT_TOP_K=10
# ReAct loop cap (used by /api/v1/agent and /api/v1/selfrag).
AGENT_MAX_ITERATIONS=8
# Reflective synthesis cap (used by /api/v1/selfrag).
AGENT_MAX_REFINEMENTS=3
# R10: mount /api/v1/legacy/agent route as comparative baseline
# for answer-quality eval.  Production traffic should use /agent or
# /selfrag, not the legacy judge path.
AGENT_ENABLE_LEGACY_AGENT=false
